\citation{lewis2020retrieval}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces  A comparison of different methods for solving arithmetic tasks. \textbf  {Addition \& Subtraction}. Can the model generalize on addition and subtraction tasks? \textbf  {Multiplication \& Division}. Can the model generalize on multiplication and division tasks? \textbf  {Single-step Solutions}. Does the model run in constant time? \textbf  {On GPU}. Does the model run entirely on the GPU? \textbf  {Explicit Representation}. Can you tell when the model performs an arithmetic operation? \textbf  {Modularity}. Can you tell how the model uses the results of an arithmetic operation? \textbf  {Internal}. Is the arithmetic task solved entirely within latent variables, or does it need to generate output tokens? \textbf  {Pretraining}. Is it possible to train the technique during pretraining, or is it only added afterwards? \textbf  {Dynamic Number Lengths}. Can the model work with inputs of any size? \textbf  {Generically Extensible}. Can the technique be extended to other tasks? }}{8}{table.caption.6}\protected@file@percent }
\newlabel{tab:comparison_of_traits}{{2}{8}{A comparison of different methods for solving arithmetic tasks. \textbf {Addition \& Subtraction}. Can the model generalize on addition and subtraction tasks? \textbf {Multiplication \& Division}. Can the model generalize on multiplication and division tasks? \textbf {Single-step Solutions}. Does the model run in constant time? \textbf {On GPU}. Does the model run entirely on the GPU? \textbf {Explicit Representation}. Can you tell when the model performs an arithmetic operation? \textbf {Modularity}. Can you tell how the model uses the results of an arithmetic operation? \textbf {Internal}. Is the arithmetic task solved entirely within latent variables, or does it need to generate output tokens? \textbf {Pretraining}. Is it possible to train the technique during pretraining, or is it only added afterwards? \textbf {Dynamic Number Lengths}. Can the model work with inputs of any size? \textbf {Generically Extensible}. Can the technique be extended to other tasks?}{table.caption.6}{}}
