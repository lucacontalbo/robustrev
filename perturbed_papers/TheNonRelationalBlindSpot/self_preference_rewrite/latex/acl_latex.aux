\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Statistics of the $\textsc  {Gradino}$\xspace  -generated data used in our experiments. \textbf  {\# inst.}\ is the number of instances retained after the question-verification pass (\S  \ref {sec:approach}); \textbf  {\% disc.}\ is the share of generated candidates discarded by the schema-format check (\S  \ref {subsec:data-generation}, \S  \ref {sec:semantic_constraints}). Under \textit  {Question composition}, each split is balanced across the listed table counts, aggregation operators (sum, average, superlative), unit settings (same vs.\ mixed units, where applicable), and, for the ablation, relational vs.\ non-relational views. The rel./non-rel.\ ablation counts both the relational and non-relational rendering of each latent instance ($216 = 108\times 2$ single-table, $168 = 84\times 2$ multi-table; cf.\ \S  \ref {sec:discussion}).}}{19}{table.caption.17}\protected@file@percent }
\newlabel{tab:data_statistics}{{8}{19}{Statistics of the \name -generated data used in our experiments. \textbf {\# inst.}\ is the number of instances retained after the question-verification pass (\S \ref {sec:approach}); \textbf {\% disc.}\ is the share of generated candidates discarded by the schema-format check (\S \ref {subsec:data-generation}, \S \ref {sec:semantic_constraints}). Under \textit {Question composition}, each split is balanced across the listed table counts, aggregation operators (sum, average, superlative), unit settings (same vs.\ mixed units, where applicable), and, for the ablation, relational vs.\ non-relational views. The rel./non-rel.\^^Mablation counts both the relational and non-relational rendering of each latent instance ($216 = 108\times 2$ single-table, $168 = 84\times 2$ multi-table; cf.\ \S \ref {sec:discussion})}{table.caption.17}{}}
